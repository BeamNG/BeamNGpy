{
    "template_car_body_sedan": {
        "information":{
            "authors":"BeamNG",
            "name":"Sedan Body",
            "value":100,
        },
        "slotType" : "template_car_body",
        "flexbodies": [
            ["mesh",                "[group]:", "nonFlexMaterials"],
            ["template_car_front",     ["body"],     [], {"pos":{"x": 0,"y":0,"z":0.000},"scale":{"x":{{(body_width|float /1.6 ) | round(3)}},"y":{{ (front_overhang|float /0.68) | round(3) }},"z":{{ (body_height *0.909|float) | round(3) }}}}],
            ["template_car_sedan_middle",    ["body"],     [], {"pos":{"x": 0,"y":{{ (wheelbase|float ) | round(3) }},"z":0.000},"scale":{"x":{{(body_width|float /1.6 ) | round(3)}},"y":{{ (wheelbase|float /2.52) | round(3) }},"z":{{ (body_height|float *0.909) | round(3) }}}}],
            ["template_car_sedan_rear",      ["body"],     [], {"pos":{"x": 0,"y":{{ (wheelbase|float ) | round(3) }},"z":0.000},"scale":{"x":{{(body_width|float /1.6 ) | round(3)}},"y":{{ (rear_overhang|float /0.7 ) | round(3) }},"z":{{ (body_height|float *0.909) | round(3) }}}}],
        ],
        //controllers are lua modules used to add higher level control of the vehicle lua (powertrain, electrics, hydros, etc)
        "controller": [
            ["fileName"],
            //vehicleController is required to have a vehicle with functioning powertrain
            ["vehicleController", {}]
        ],
        //refnodes are a reference coordinate system created from nodes of the vehicle. used for camera orientation, spawning location
        //should create an orthogonal shape and the closer to the center of the vehicle the better
        //leftCorner and rightCorner are used for triggering scenario waypoints
        "refNodes":[
            ["ref:", "back:", "left:", "up:", "leftCorner:", "rightCorner:"],
            ["b2",   "b3",    "b2l",   "b6",  "f3ll",        "f3rr"],
        ],
        //sets the placement of the orbit and chase cameras relative to the "ref:" node
        // python changes the camera position for QoL
        "cameraChase":{
            "distance":"$= 2 + {{ (wheelbase|float + rear_overhang|float) | round(3) }}" ,
            "offset":{"x":0, "y":0, "z":"$= {{ (body_height|float * 0.1) | round(3) }}"},
            "distanceMin":2,
            "defaultRotation":{"x":0,"y":-12,"z":0},
            "fov":65,
        },
        "cameraExternal":{
            "distance":"$= 2 + {{ (wheelbase|float + rear_overhang|float) | round(3) }}" ,
            "offset":{"x":0, "y":0, "z":"$= {{ (body_height|float * 0.1) | round(3) }}"},
            "distanceMin":2,
            "fov":65,
        },
        "nodes": [
            ["id",      "posX",      "posY",    "posZ"],
            {"frictionCoef":0.5},
            {"nodeMaterial":"|NM_METAL"},
            //collision: does the node collide with the ground, static objects, and other vehicle collision tris
            {"collision":true},
            //selfCollision: does the node collide with own collision tris
            {"selfCollision":false},
            //group:used to create a group of nodes that a flexbody (deformable mesh) can be bound to
            {"group":"body"},
            {"nodeWeight":20},
            //python changes node position and weights for dimentional adjustment and CoG/yaw inertia adjustment
            //body front lower
            //center
            ["f1",      {{ (f1_x|float) | round(3) }},      {{ (f1_y|float) | round(3) }},     {{ (f1_z|float) | round(3) }},  {"nodeWeight":{{ (f1_m|float) }}}],
            //left
            ["f1l",     {{ (f1l_x|float) | round(3) }},      {{ (f1l_y|float) | round(3) }},     {{ (f1l_z|float) | round(3) }},  {"nodeWeight":{{ (f1l_m|float) }}}], //refined to dae shape see if squaring it off makes sense
            ["f1ll",    {{ (f1ll_x|float) | round(3) }},      {{ (f1ll_y|float) | round(3) }},     {{ (f1ll_z|float) | round(3) }},  {"nodeWeight":{{ (f1ll_m|float) }}}],
            //right
            ["f1r",    {{ (f1r_x|float) | round(3) }},      {{ (f1r_y|float) | round(3) }},     {{ (f1r_z|float) | round(3) }},  {"nodeWeight":{{ (f1r_m|float) }}}],
            ["f1rr",   {{ (f1rr_x|float) | round(3) }},      {{ (f1rr_y|float) | round(3) }},     {{ (f1rr_z|float) | round(3) }},  {"nodeWeight":{{ (f1rr_m|float) }}}],
            ["f2",      {{ (f2_x|float) | round(3) }},       {{ (f2_y|float) | round(3) }},     {{ (f2_z|float) | round(3) }},  {"nodeWeight":{{ (f2_m|float) }}}],
            ["f2l",     {{ (f2l_x|float) | round(3) }},       {{ (f2l_y|float) | round(3) }},     {{ (f2l_z|float) | round(3) }},  {"nodeWeight":{{ (f2l_m|float) }}}],
            ["f2r",    {{ (f2r_x|float) | round(3) }},       {{ (f2r_y|float) | round(3) }},     {{ (f2r_z|float) | round(3) }},  {"nodeWeight":{{ (f2r_m|float) }}}],
            //body front upper
            //center
            ["f3",      {{ (f3_x|float) | round(3) }},      {{ (f3_y|float) | round(3) }},     {{ (f3_z|float) | round(3) }},  {"nodeWeight":{{ (f3_m|float) }}}],
            ["f4",      {{ (f4_x|float) | round(3) }},        {{ (f4_y|float) | round(3) }},     {{ (f4_z|float) | round(3) }},  {"nodeWeight":{{ (f4_m|float) }}}],
            //left
            ["f3l",     {{ (f3l_x|float) | round(3) }},      {{ (f3l_y|float) | round(3) }},     {{ (f3l_z|float) | round(3) }},  {"nodeWeight":{{ (f3l_m|float) }}}],
            ["f3ll",    {{ (f3ll_x|float) | round(3) }},      {{ (f3ll_y|float) | round(3) }},     {{ (f3ll_z|float) | round(3) }},  {"nodeWeight":{{ (f3ll_m|float) }}}],
            ["f4l",     {{ (f4l_x|float) | round(3) }},       {{ (f4l_y|float) | round(3) }},     {{ (f4l_z|float) | round(3) }},  {"nodeWeight":{{ (f4l_m|float) }}}],
            //right
            ["f3r",    {{ (f3r_x|float) | round(3) }},      {{ (f3r_y|float) | round(3) }},     {{ (f3r_z|float) | round(3) }},  {"nodeWeight":{{ (f3r_m|float) }}}],
            ["f3rr",   {{ (f3rr_x|float) | round(3) }},      {{ (f3rr_y|float) | round(3) }},     {{ (f3rr_z|float) | round(3) }},  {"nodeWeight":{{ (f3rr_m|float) }}}],
            ["f4r",    {{ (f4r_x|float) | round(3) }},       {{ (f4r_y|float) | round(3) }},     {{ (f4r_z|float) | round(3) }},  {"nodeWeight":{{ (f4_m|float) }}}],
            //body middle (b1, b2, ... b8)
            ["b1",      {{ (b1_x|float) | round(3) }},       {{ (b1_y|float) | round(3) }},     {{ (b1_z|float) | round(3) }},  {"nodeWeight":{{ (b1_m|float) }}}],
            ["b1l",     {{ (b1l_x|float) | round(3) }},       {{ (b1l_y|float) | round(3) }},     {{ (b1l_z|float) | round(3) }},  {"nodeWeight":{{ (b1l_m|float) }}}],
            ["b1r",    {{ (b1r_x|float) | round(3) }},       {{ (b1r_y|float) | round(3) }},     {{ (b1r_z|float) | round(3) }},  {"nodeWeight":{{ (b1r_m|float) }}}],
            ["b2",      {{ (b2_x|float) | round(3) }},       {{ (b2_y|float) | round(3) }},     {{ (b2_z|float) | round(3) }},  {"nodeWeight":{{ (b2_m|float) }}}],    //center of car, use as refnode for center
            ["b2l",     {{ (b2l_x|float) | round(3) }},       {{ (b2l_y|float) | round(3) }},     {{ (b2l_z|float) | round(3) }},  {"nodeWeight":{{ (b2l_m|float) }}}],
            ["b2r",    {{ (b2r_x|float) | round(3) }},       {{ (b2r_y|float) | round(3) }},     {{ (b2r_z|float) | round(3) }},  {"nodeWeight":{{ (b2r_m|float) }}}],
            ["b3",      {{ (b3_x|float) | round(3) }},       {{ (b3_y|float) | round(3) }},     {{ (b3_z|float) | round(3) }},  {"nodeWeight":{{ (b3_m|float) }}}],
            ["b3l",     {{ (b3l_x|float) | round(3) }},       {{ (b3l_y|float) | round(3) }},     {{ (b3l_z|float) | round(3) }},  {"nodeWeight":{{ (b3l_m|float) }}}],
            ["b3r",    {{ (b3r_x|float) | round(3) }},       {{ (b3r_y|float) | round(3) }},     {{ (b3r_z|float) | round(3) }},  {"nodeWeight":{{ (b3r_m|float) }}}],
            ["b4",      {{ (b4_x|float) | round(3) }},       {{ (b4_y|float) | round(3) }},     {{ (b4_z|float) | round(3) }},  {"nodeWeight":{{ (b4_m|float) }}}],
            ["b4l",     {{ (b4l_x|float) | round(3) }},       {{ (b4l_y|float) | round(3) }},     {{ (b4l_z|float) | round(3) }},  {"nodeWeight":{{ (b4l_m|float) }}}],    //rear suspension attach point
            ["b4r",    {{ (b4r_x|float) | round(3) }},       {{ (b4r_y|float) | round(3) }},     {{ (b4r_z|float) | round(3) }},  {"nodeWeight":{{ (b4r_m|float) }}}],    //rear suspension attach point
            ["b5",      {{ (b5_x|float) | round(3) }},       {{ (b5_y|float) | round(3) }},     {{ (b5_z|float) | round(3) }},  {"nodeWeight":{{ (b5_m|float) }}}],
            ["b5l",     {{ (b5l_x|float) | round(3) }},       {{ (b5l_y|float) | round(3) }},     {{ (b5l_z|float) | round(3) }},  {"nodeWeight":{{ (b5l_m|float) }}}],
            ["b5r",    {{ (b5r_x|float) | round(3) }},       {{ (b5r_y|float) | round(3) }},     {{ (b5r_z|float) | round(3) }},  {"nodeWeight":{{ (b5r_m|float) }}}],
            ["b6",      {{ (b6_x|float) | round(3) }},       {{ (b6_y|float) | round(3) }},     {{ (b6_z|float) | round(3) }},  {"nodeWeight":{{ (b6_m|float) }}}],
            ["b6l",     {{ (b6l_x|float) | round(3) }},       {{ (b6l_y|float) | round(3) }},     {{ (b6l_z|float) | round(3) }},  {"nodeWeight":{{ (b6l_m|float) }}}],
            ["b6r",    {{ (b6r_x|float) | round(3) }},       {{ (b6r_y|float) | round(3) }},     {{ (b6r_z|float) | round(3) }},  {"nodeWeight":{{ (b6r_m|float) }}}],
            ["b7",      {{ (b7_x|float) | round(3) }},       {{ (b7_y|float) | round(3) }},     {{ (b7_z|float) | round(3) }},  {"nodeWeight":{{ (b7_m|float) }}}],
            ["b7l",     {{ (b7l_x|float) | round(3) }},       {{ (b7l_y|float) | round(3) }},     {{ (b7l_z|float) | round(3) }},  {"nodeWeight":{{ (b7l_m|float) }}}],
            ["b7r",    {{ (b7r_x|float) | round(3) }},       {{ (b7r_y|float) | round(3) }},     {{ (b7r_z|float) | round(3) }},  {"nodeWeight":{{ (b7r_m|float) }}}],
            ["b8",      {{ (b8_x|float) | round(3) }},       {{ (b8_y|float) | round(3) }},     {{ (b8_z|float) | round(3) }},  {"nodeWeight":{{ (b8_m|float) }}}],
            ["b8l",     {{ (b8l_x|float) | round(3) }},       {{ (b8l_y|float) | round(3) }},     {{ (b8l_z|float) | round(3) }},  {"nodeWeight":{{ (b8l_m|float) }}}],
            ["b8r",    {{ (b8r_x|float) | round(3) }},       {{ (b8r_y|float) | round(3) }},     {{ (b8r_z|float) | round(3) }},  {"nodeWeight":{{ (b8r_m|float) }}}],
            //body rear (r1, r2)
            ["r1",      {{ (r1_x|float) | round(3) }},       {{ (r1_y|float) | round(3) }},     {{ (r1_z|float) | round(3) }},  {"nodeWeight":{{ (r1_m|float) }}}],
            ["r1l",     {{ (r1l_x|float) | round(3) }},       {{ (r1l_y|float) | round(3) }},     {{ (r1l_z|float) | round(3) }},  {"nodeWeight":{{ (r1l_m|float) }}}],
            ["r1ll",    {{ (r1ll_x|float) | round(3) }},       {{ (r1ll_y|float) | round(3) }},     {{ (r1ll_z|float) | round(3) }},  {"nodeWeight":{{ (r1ll_m|float) }}}],
            ["r1r",    {{ (r1r_x|float) | round(3) }},       {{ (r1r_y|float) | round(3) }},     {{ (r1r_z|float) | round(3) }},  {"nodeWeight":{{ (r1r_m|float) }}}],
            ["r1rr",   {{ (r1rr_x|float) | round(3) }},       {{ (r1rr_y|float) | round(3) }},     {{ (r1rr_z|float) | round(3) }},  {"nodeWeight":{{ (r1rr_m|float) }}}],
            ["r2",      {{ (r2_x|float) | round(3) }},       {{ (r2_y|float) | round(3) }},     {{ (r2_z|float) | round(3) }},  {"nodeWeight":{{ (r2_m|float) }}}],
            ["r2l",     {{ (r2l_x|float) | round(3) }},       {{ (r2l_y|float) | round(3) }},     {{ (r2l_z|float) | round(3) }},  {"nodeWeight":{{ (r2l_m|float) }}}],
            ["r2ll",    {{ (r2ll_x|float) | round(3) }},       {{ (r2ll_y|float) | round(3) }},     {{ (r2ll_z|float) | round(3) }},  {"nodeWeight":{{ (r2ll_m|float) }}}],
            ["r2r",    {{ (r2r_x|float) | round(3) }},       {{ (r2r_y|float) | round(3) }},     {{ (r2r_z|float) | round(3) }},  {"nodeWeight":{{ (r2r_m|float) }}}],
            ["r2rr",   {{ (r2rr_x|float) | round(3) }},       {{ (r2rr_y|float) | round(3) }},     {{ (r2rr_z|float) | round(3) }},  {"nodeWeight":{{ (r2rr_m|float) }}}],
            //roof nodes (rf1, rf2, rf3)
            {"nodeWeight":20},
            ["rf1",     {{ (rf1_x|float) | round(3) }},       {{ (rf1_y|float) | round(3) }},     {{ (rf1_z|float) | round(3) }},  {"nodeWeight":{{ (rf1_m|float) }}}],
            ["rf1l",    {{ (rf1l_x|float) | round(3) }},       {{ (rf1l_y|float) | round(3) }},     {{ (rf1l_z|float) | round(3) }},  {"nodeWeight":{{ (rf1l_m|float) }}}],
            ["rf1r",   {{ (rf1r_x|float) | round(3) }},       {{ (rf1r_y|float) | round(3) }},     {{ (rf1r_z|float) | round(3) }},  {"nodeWeight":{{ (rf1r_m|float) }}}],
            ["rf2",     {{ (rf2_x|float) | round(3) }},       {{ (rf2_y|float) | round(3) }},     {{ (rf2_z|float) | round(3) }},  {"nodeWeight":{{ (rf2_m|float) }}}],
            ["rf2l",    {{ (rf2l_x|float) | round(3) }},       {{ (rf2l_y|float) | round(3) }},     {{ (rf2l_z|float) | round(3) }},  {"nodeWeight":{{ (rf2l_m|float) }}}],
            ["rf2r",   {{ (rf2r_x|float) | round(3) }},       {{ (rf2r_y|float) | round(3) }},     {{ (rf2r_z|float) | round(3) }},  {"nodeWeight":{{ (rf2r_m|float) }}}],
            ["rf3",     {{ (rf3_x|float) | round(3) }},       {{ (rf3_y|float) | round(3) }},     {{ (rf3_z|float) | round(3) }},  {"nodeWeight":{{ (rf3_m|float) }}}],
