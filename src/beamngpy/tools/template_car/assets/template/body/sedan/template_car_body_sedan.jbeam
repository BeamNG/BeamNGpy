            ["b8r",  "b2r", {"beamSpring": {{ ((b8r_m|float)*(b2r_m|float)) / ((b8r_m|float)+(b2r_m|float) + 1e-3) * 480000 }}}],
            ["r2ll", "b3l", {"beamSpring": {{ ((r2ll_m|float)*(b3l_m|float)) / ((r2ll_m|float)+(b3l_m|float) + 1e-3) * 480000 }}}],
