            ["rf3r",   {{ (rf3r_x|float) | round(3) }},       {{ (rf3r_y|float) | round(3) }},     {{ (rf3r_z|float) | round(3) }},  {"nodeWeight":{{ (rf3r_m|float) }}}],
            //suspension attached in suspension jbeam, offset correctly by main jbeam file
            //it is good practice to close any defined property as they can leak from one file into another
            {"group":""},
        ],
        "beams": [
            ["id1:", "id2:"],
            {"beamStrength":"FLT_MAX"},

            //enticers
            {"beamSpring":1200000,"beamDamp":1500},
            {"beamDeform":40000},
            ["f4r",  "b2r", {"beamSpring": {{ ((f4r_m|float)*(b2r_m|float)) / ((f4r_m|float)+(b2r_m|float) + 1e-3) * 480000 }}}],
            ["f4l",  "b2l", {"beamSpring": {{ ((f4l_m|float)*(b2l_m|float)) / ((f4l_m|float)+(b2l_m|float) + 1e-3) * 480000 }}}],
