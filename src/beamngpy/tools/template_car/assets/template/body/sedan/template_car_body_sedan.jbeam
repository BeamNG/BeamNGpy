            ["f3",   "b1", {"beamSpring": {{ ((f3_m|float)*(b1_m|float)) / ((f3_m|float)+(b1_m|float) + 1e-3) * 480000 }}}],
            ["f3rr", "b1r", {"beamSpring": {{ ((f3rr_m|float)*(b1r_m|float)) / ((f3rr_m|float)+(b1r_m|float) + 1e-3) * 480000 }}}],
            ["b5l",  "b3l", {"beamSpring": {{ ((b5l_m|float)*(b3l_m|float)) / ((b5l_m|float)+(b3l_m|float) + 1e-3) * 480000 }}}],
            ["b5r",  "b3r", {"beamSpring": {{ ((b5r_m|float)*(b3r_m|float)) / ((b5r_m|float)+(b3r_m|float) + 1e-3) * 480000 }}}],

            {"beamDeform":5000},
            ["f1ll", "b5l", {"beamSpring": {{ ((f1ll_m|float)*(b5l_m|float)) / ((f1ll_m|float)+(b5l_m|float) + 1e-3) * 480000 }}}],
            ["f1",   "b5", {"beamSpring": {{ ((f1_m|float)*(b5_m|float)) / ((f1_m|float)+(b5_m|float) + 1e-3) * 480000 }}}],
            ["f1rr", "b5r", {"beamSpring": {{ ((f1rr_m|float)*(b5r_m|float)) / ((f1rr_m|float)+(b5r_m|float) + 1e-3) * 480000 }}}],

            //body main shape
            {"deformLimitExpansion":1.2},
            {"beamSpring":1200000,"beamDamp":1200},
            {"beamDeform":20000},
            //widthwise
            ["b1r",  "b1", {"beamSpring": {{ ((b1r_m|float)*(b1_m|float)) / ((b1r_m|float)+(b1_m|float) + 1e-3) * 480000 }}}],
            ["b1",   "b1l", {"beamSpring": {{ ((b1_m|float)*(b1l_m|float)) / ((b1_m|float)+(b1l_m|float) + 1e-3) * 480000 }}}],
