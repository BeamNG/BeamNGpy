            ["b6r",    {{ (b6r_x|float) | round(3) }},       {{ (b6r_y|float) | round(3) }},     {{ (b6r_z|float) | round(3) }},  {"nodeWeight":{{ (b6r_m|float) }}}],
            ["b7",      {{ (b7_x|float) | round(3) }},       {{ (b7_y|float) | round(3) }},     {{ (b7_z|float) | round(3) }},  {"nodeWeight":{{ (b7_m|float) }}}],
            ["b7l",     {{ (b7l_x|float) | round(3) }},       {{ (b7l_y|float) | round(3) }},     {{ (b7l_z|float) | round(3) }},  {"nodeWeight":{{ (b7l_m|float) }}}],
            ["b7r",    {{ (b7r_x|float) | round(3) }},       {{ (b7r_y|float) | round(3) }},     {{ (b7r_z|float) | round(3) }},  {"nodeWeight":{{ (b7r_m|float) }}}],
            ["b8",      {{ (b8_x|float) | round(3) }},       {{ (b8_y|float) | round(3) }},     {{ (b8_z|float) | round(3) }},  {"nodeWeight":{{ (b8_m|float) }}}],
            ["b8l",     {{ (b8l_x|float) | round(3) }},       {{ (b8l_y|float) | round(3) }},     {{ (b8l_z|float) | round(3) }},  {"nodeWeight":{{ (b8l_m|float) }}}],
            ["b8r",    {{ (b8r_x|float) | round(3) }},       {{ (b8r_y|float) | round(3) }},     {{ (b8r_z|float) | round(3) }},  {"nodeWeight":{{ (b8r_m|float) }}}],
            //body rear (r1, r2)
            ["r1",      {{ (r1_x|float) | round(3) }},       {{ (r1_y|float) | round(3) }},     {{ (r1_z|float) | round(3) }},  {"nodeWeight":{{ (r1_m|float) }}}],
            ["r1l",     {{ (r1l_x|float) | round(3) }},       {{ (r1l_y|float) | round(3) }},     {{ (r1l_z|float) | round(3) }},  {"nodeWeight":{{ (r1l_m|float) }}}],
            ["r1ll",    {{ (r1ll_x|float) | round(3) }},       {{ (r1ll_y|float) | round(3) }},     {{ (r1ll_z|float) | round(3) }},  {"nodeWeight":{{ (r1ll_m|float) }}}],
            ["r1r",    {{ (r1r_x|float) | round(3) }},       {{ (r1r_y|float) | round(3) }},     {{ (r1r_z|float) | round(3) }},  {"nodeWeight":{{ (r1r_m|float) }}}],
            ["r1rr",   {{ (r1rr_x|float) | round(3) }},       {{ (r1rr_y|float) | round(3) }},     {{ (r1rr_z|float) | round(3) }},  {"nodeWeight":{{ (r1rr_m|float) }}}],
            ["r2",      {{ (r2_x|float) | round(3) }},       {{ (r2_y|float) | round(3) }},     {{ (r2_z|float) | round(3) }},  {"nodeWeight":{{ (r2_m|float) }}}],
            ["r2l",     {{ (r2l_x|float) | round(3) }},       {{ (r2l_y|float) | round(3) }},     {{ (r2l_z|float) | round(3) }},  {"nodeWeight":{{ (r2l_m|float) }}}],
            ["r2ll",    {{ (r2ll_x|float) | round(3) }},       {{ (r2ll_y|float) | round(3) }},     {{ (r2ll_z|float) | round(3) }},  {"nodeWeight":{{ (r2ll_m|float) }}}],
            ["r2r",    {{ (r2r_x|float) | round(3) }},       {{ (r2r_y|float) | round(3) }},     {{ (r2r_z|float) | round(3) }},  {"nodeWeight":{{ (r2r_m|float) }}}],
            ["r2rr",   {{ (r2rr_x|float) | round(3) }},       {{ (r2rr_y|float) | round(3) }},     {{ (r2rr_z|float) | round(3) }},  {"nodeWeight":{{ (r2rr_m|float) }}}],
            //roof nodes (rf1, rf2, rf3)
            {"nodeWeight":10},
            ["rf1",     {{ (rf1_x|float) | round(3) }},       {{ (rf1_y|float) | round(3) }},     {{ (rf1_z|float) | round(3) }},  {"nodeWeight":{{ (rf1_m|float) }}}],
            ["rf1l",    {{ (rf1l_x|float) | round(3) }},       {{ (rf1l_y|float) | round(3) }},     {{ (rf1l_z|float) | round(3) }},  {"nodeWeight":{{ (rf1l_m|float) }}}],
            ["rf1r",   {{ (rf1r_x|float) | round(3) }},       {{ (rf1r_y|float) | round(3) }},     {{ (rf1r_z|float) | round(3) }},  {"nodeWeight":{{ (rf1r_m|float) }}}],
            ["rf2",     {{ (rf2_x|float) | round(3) }},      {{ (rf2_y|float) | round(3) }},     {{ (rf2_z|float) | round(3) }},  {"nodeWeight":{{ (rf2_m|float) }}}],
            ["rf2l",    {{ (rf2l_x|float) | round(3) }},       {{ (rf2l_y|float) | round(3) }},     {{ (rf2l_z|float) | round(3) }},  {"nodeWeight":{{ (rf2l_m|float) }}}],
            ["rf2r",   {{ (rf2r_x|float) | round(3) }},       {{ (rf2r_y|float) | round(3) }},     {{ (rf2r_z|float) | round(3) }},  {"nodeWeight":{{ (rf2r_m|float) }}}],
