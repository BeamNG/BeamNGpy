{
    "template_car_strut_R": {
        "information":{
            "authors":"BeamNG",
            "name":"MacPherson Strut Rear Suspension",
            "value":150,
        },
        "slotType" : "template_car_suspension_R",
        "slots2": [
            ["name", "allowTypes", "denyTypes", "default", "description"],
            ["template_car_hub_R", ["template_car_hub_R"], [], "template_car_hub_R_4", "Rear Hubs"],   // parts can be loaded from other jbeam files
            //the coordinates of the nodeOffset determine where the common wheel is placed when it is loaded based on slot order
            ["template_car_wheeldata_R_strut", ["template_car_wheeldata_R_strut"], [], "template_car_wheeldata_R_strut", "Rear Spindles", {"coreSlot":true}],
            ["template_car_coilover_R_strut", ["template_car_coilover_R_strut"], [], "template_car_coilover_R_strut", "Rear Coilovers", {"nodeOffset":{"x":0.0, "y":{{ wheelbase|float }}, "z":0.105}}],
            ["template_car_swaybar_R_strut", ["template_car_swaybar_R_strut"], [], "template_car_swaybar_R_strut", "Rear Sway Bar", {"nodeOffset":{"x":0.0, "y":{{ wheelbase|float }}, "z":0.105}}],
        ],
        "flexbodies": [
            ["mesh", "[group]:", "nonFlexMaterials"],
            //add mesh here if you want to visibly show certain components
        ],
        "nodes": [
            ["id", "posX", "posY", "posZ"],
            {"collision":true},
            {"selfCollision":false},
            {"nodeMaterial":"|NM_METAL"},
            {"frictionCoef":0.5},
            {"group":"hub_R"},
            //rear hub
            //wheel axle nodes (rw1rr/rw1ll, rw1r/rw1l) come from the common wheel slots that are loaded in the "wheel_R_4" slot
            {"nodeWeight":9},
            //strut rail bottom point                                                   [lower ball joint]
            ["rh1r", -0.61, 0, -0.125],
            ["rh1l",  0.61, 0, -0.125],

            //strut body slidenode
            ["rh2r", -0.500, 0, 0.125],
            ["rh2l",  0.500, 0, 0.125],

            //hub mounting points for lower wishbone
            ["rh3r", -0.63, -0.07, -0.125],
            ["rh3l",  0.63, -0.07, -0.125],
            ["rh4r", -0.63,  0.07, -0.125],
            ["rh4l",  0.63,  0.07, -0.125],

            //brake caliper
            {"group":"brakearm_R"},
            ["rh5r", -0.63,  0.14, 0],
            ["rh5l",  0.63,  0.14, 0],

            {"nodeWeight":8.0},
            {"group":["subframe_R","lowerarm_R"]},
            //body mounting points for lower wishbone
            ["rx1r", -0.29, -0.2, -0.1],                                              //[LCA front bush]
            ["rx1l",  0.29, -0.2, -0.1],                                              //[LCA front bush]
            ["rx2r", -0.29,  0.2, -0.1],                                              //[LCA rear bush]
            ["rx2l",  0.29,  0.2, -0.1],                                              //[LCA rear bush]

            //strut rail top point                                                      [strut rod upper]
            ["rs1r", -0.38, 0, 0.42],
            ["rs1l",  0.38, 0, 0.42],
            {"group":""},
        ],
        "rails": {
            //rails form a line between 2 nodes that slidenodes will slide on. Used for any kind of telescoping motion such as steering racks, hydraulic rams, strut shafts.
            //strut shaft rail
            "strut_RR":{
                "links:":["rh1r", "rs1r"], "broken:":[], "looped":false, "capped":true,
            },
            "strut_RL":{
                "links:":["rh1l", "rs1l"], "broken:":[], "looped":false, "capped":true,
            },
        },
        "slidenodes": [
            ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
            //attach strut body to strut shaft rail
            ["rh2r", "strut_RR", true, true, 0.0, 18001000, "FLT_MAX", "FLT_MAX"],
            ["rh2l", "strut_RL", true, true, 0.0, 18001000, "FLT_MAX", "FLT_MAX"],
        ],
        "beams": [
            ["id1:", "id2:"],
            //macpherson strut suspension
            {"beamPrecompression":1, "beamType":"|NORMAL"},
            {"beamSpring":8001000,"beamDamp":100},
            {"beamDeform":51000,"beamStrength":351000},
            //hub
            ["rh2r","rh3r"],
            ["rh2l","rh3l"],
            ["rh2r","rh5r"],
            ["rh2l","rh5l"],
            ["rh3r","rh5r"],
            ["rh3l","rh5l"],
            ["rh2l","rh4l"],
            ["rh5l","rh4l"],
            ["rh2r","rh4r"],
            ["rh5r","rh4r"],
            ["rh3l", "rh4l"],
            ["rh3r", "rh4r"],

            ["rh1r", "rh4r"],
            ["rh1r", "rh3r"],
            ["rh1r", "rh2r"],
            ["rh1r", "rh5r"],
            ["rh1l", "rh4l"],
            ["rh1l", "rh3l"],
            ["rh1l", "rh2l"],
            ["rh1l", "rh5l"],

            //hub to wheel axle nodes
            //breakGroup: when one beam breaks, all beams in the group are forced to break
            {"breakGroup":"wheel_RR"},
            {"optional":true},
            //optional: tells the physics engine not to worry if it can't find the nodes (ie, user chose to remove the wheels)
            ["rh1r","rw1r", {"name":"axle_RR"}],
            ["rh2r","rw1r", {"name":"axle_RR"}],
            ["rh3r","rw1r"],
            ["rh4r","rw1r"],
            ["rh5r","rw1r"],
            ["rh1r","rw1rr", {"beamSpring":9001000,"beamStrength":951000,"beamPrecompression":1.15,"beamPrecompressionTime":1.0}],       //camber adjust],
            ["rh2r","rw1rr", {"beamSpring":9001000,"beamStrength":951000,"beamPrecompression":0.91,"beamPrecompressionTime":1.0}],       //camber adjust
            ["rh3r","rw1rr"],
            ["rh4r","rw1rr"],
            ["rh5r","rw1rr"],
            {"breakGroup":"wheel_RL"},
            ["rh1l","rw1l", {"name":"axle_RL"}],
            ["rh2l","rw1l", {"name":"axle_RL"}],
            ["rh3l","rw1l"],
            ["rh4l","rw1l"],
            ["rh5l","rw1l"],
            ["rh1l","rw1ll", {"beamSpring":9001000,"beamStrength":951000,"beamPrecompression":1.15,"beamPrecompressionTime":1.0}],       //camber adjust],
            ["rh2l","rw1ll", {"beamSpring":9001000,"beamStrength":951000,"beamPrecompression":0.91,"beamPrecompressionTime":1.0}],       //camber adjust
            ["rh3l","rw1ll"],
            ["rh4l","rw1ll"],
            ["rh5l","rw1ll"],
            {"optional":false},
            {"breakGroup":""},

            //lower wishbone
            {"beamSpring":10001000,"beamDamp":2000},
            ["rh3r", "rx2r", {"dampCutoffHz":500}],
            ["rh4r", "rx1r", {"dampCutoffHz":500}],
            {"highlight":{"radius":0.01, "col":"#FF00007F"}},
            ["rh3r", "rx1r", {"dampCutoffHz":500,"beamPrecompression":0.9985}],             //toe adjustment
            ["rh4r", "rx2r", {"dampCutoffHz":500}],
            {"highlight":{"radius":0.0, "col":"#00000000"}},

            ["rh3l", "rx2l", {"dampCutoffHz":500}],
            ["rh4l", "rx1l", {"dampCutoffHz":500}],
            {"highlight":{"radius":0.01, "col":"#FF00007F"}},
            ["rh3l", "rx1l", {"dampCutoffHz":500,"beamPrecompression":0.9985}],             //toe adjustment
            ["rh4l", "rx2l", {"dampCutoffHz":500}],
            {"highlight":{"radius":0.0, "col":"#00000000"}},

            //subframe
            {"beamSpring":8001000,"beamDamp":250},
            ["rx1l", "rx2l"],
            ["rx1r", "rx2r"],
            ["rx1l", "rx1r"],
            ["rx2l", "rx2r"],
            ["rx1l", "rx2r"],
            ["rx2l", "rx1r"],

            //strut tower
            {"beamSpring":5001000,"beamDamp":250},
            ["rs1l", "rx1l"],
            ["rs1l", "rx2l"],
            ["rs1r", "rx1r"],
            ["rs1r", "rx2r"],
            ["rs1r", "rs1l"],

            ["rs1l", "rx1r"],
            ["rs1r", "rx1l"],
            ["rs1l", "rx2r"],
            ["rs1r", "rx2l"],
            ["rs1r", "b8r"],
            ["rs1l", "b8l"],
            ["rs1l", "b8r"],
            ["rs1r", "b8l"],

            //subframe to body
            {"beamSpring":8001000,"beamDamp":250},
            ["b3l", "rx2l"],
            ["r1ll", "rx2l"],
            ["b3r", "rx2r"],
            ["r1rr", "rx2r"],
            ["b8l", "rx2l"],
            ["b8r", "rx2r"],
            ["b3r", "rx2l"],
            ["r1rr", "rx2l"],
            ["b3l", "rx2r"],
            ["r1ll", "rx2r"],

            ["b3l", "rx1l"],
            ["r1ll", "rx1l"],
            ["b3r", "rx1r"],
            ["r1rr", "rx1r"],

            ["rx1l", "b8l"],
            ["rx1r", "b8r"],
            ["rx1l", "b8r"],
            ["rx1r", "b8l"],
            ["rx2l", "b8r"],
            ["rx2r", "b8l"],

            //wheel intrusion limiter
            {"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":1},
            {"beamSpring":1001000,"beamDamp":250,"beamDeform":165000,"beamStrength":900000},
            {"beamPrecompression":0.6},
            ["rw1ll","rx1r"],
            ["rw1ll","rx2r"],
            ["rw1rr","rx1l"],
            ["rw1rr","rx2l"],
            ["rw1ll","rs1r"],
            ["rw1rr","rs1l"],
            {"beamPrecompression":1},

            //hub inversion limiter
            {"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":3},
            {"beamSpring":1001000,"beamDamp":250,"beamDeform":165000,"beamStrength":900000},
            {"beamPrecompression":0.77},
            ["rx2l","rh2l"],
            ["rx1l","rh2l"],
            ["rx2r","rh2r"],
            ["rx1r","rh2r"],
            {"beamPrecompression":0.7},
            ["rs1r","rh1r"],
            ["rs1l","rh1l"],

            {"beamPrecompression":0.95},
            ["rx2l","rh3l"],
            ["rx1l","rh4l"],
            ["rx2r","rh3r"],
            ["rx1r","rh4r"],
            ["rx1l","rh3l"],
            ["rx2l","rh4l"],
            ["rx1r","rh3r"],
            ["rx2r","rh4r"],
            {"beamPrecompression":1},
            {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        ],
    },

    "template_car_wheeldata_R_strut": {
        "information":{
            "authors":"BeamNG",
            "name":"Rear Spindles",
            "value":0,
        },
        "slotType" : "template_car_wheeldata_R_strut",
        "pressureWheels":[
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            //some wheel properties
            {"selfCollision":false},
            {"collision":true},
            {"hubcapBreakGroup":"hubcap_RR"},
            {"hubcapGroup":"hubcap_RR"},
            {"axleBeams":["axle_RR"]},
            //wheel is created from here, but using properties from previously loaded common jbeam parts
            //choosing torque reaction nodes is a very complex topic which depends mainly on whether the differential is mounted to the same "rigid" body as the wheels or not (live axle vs independent suspension) and other things
            ["RR", "wheel_RR", "tire_RR", "rw1rr", "rw1r",  9999, "rh5r", 1, {"torqueCoupling:":"rx1r","torqueArm:":"rx2r", "torqueArm2:":"rx2l"}],
            {"hubcapBreakGroup":"hubcap_RL"},
            {"hubcapGroup":"hubcap_RL"},
            {"axleBeams":["axle_RL"]},
            ["RL", "wheel_RL", "tire_RL", "rw1ll", "rw1l", 9999, "rh5l",  -1, {"torqueCoupling:":"rx1l","torqueArm:":"rx2l", "torqueArm2:":"rx2r"}],
            //cancel out a bunch of properties before future wheel parts are loaded
            {"selfCollision":true},
            {"axleBeams":[]},{"disableMeshBreaking":false,"disableTriangleBreaking":false},
            {"hubcapBreakGroup":""},
            {"hubcapGroup":""},
            {"enableHubcaps":false},
            {"enableTireLbeams":false},
            {"enableTireSideReinfBeams":false},
            {"enableTireReinfBeams":false},
            {"enableTreadReinfBeams":false},
            {"enableTirePeripheryReinfBeams":false},
            {"loadSensitivitySlope":""},
            {"noLoadCoef":""},
            {"fullLoadCoef":""},
            {"frictionCoef":""},
            {"slidingFrictionCoef":""},
            {"softnessCoef":0.5},
            {"treadCoef":1.0},
        ],
    },
    "template_car_swaybar_R_strut": {
        "information":{
            "authors":"BeamNG",
            "name":"Rear Sway Bar",
            "value":250,
        },
        "slotType" : "template_car_swaybar_R_strut",
        "flexbodies": [
            ["mesh", "[group]:", "nonFlexMaterials"],
            //["swaybar_R", ["lowerarm_R", "swaybar_R"]],
        ],
        "torsionbars": [
            ["id1:", "id2:", "id3:", "id4:"],
            //torsional spring rate (Nm/rad) NOT end spring rate
            {"spring":500, "damp":1, "deform":10000, "strength":50000},
            ["arbrr", "rx1r", "rx1l", "arbrl"],
        ],
        "nodes": [
            ["id", "posX", "posY", "posZ"],
            {"selfCollision":false},
            {"collision":true},
            {"nodeMaterial":"|NM_METAL"},
            {"frictionCoef":0.5},
            {"group":"swaybar_R"},
            {"nodeWeight":2.5},
            ["arbrr", -0.80, 0, -0.1],
            ["arbrl",  0.80, 0, -0.1],
            {"group":""},
        ],
        "beams": [
            ["id1:", "id2:"],
            {"beamPrecompression":1, "beamType":"|NORMAL"},
            {"beamSpring":1501000,"beamDamp":100},
            {"beamDeform":52000,"beamStrength":712000},
            //end links
            ["arbrr","rh2r"],
            ["arbrl","rh2l"],
            //arm
            ["rx1r","arbrr"],
            ["rx1l","arbrl"],
            ["rx1l","arbrr"],
            ["rx1r","arbrl"],
            {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        ],
    },
    "template_car_coilover_R_strut": {
        "information":{
            "authors":"BeamNG",
            "name":"Rear Coilovers",
            "value":200,
        },
        "slotType" : "template_car_coilover_R_strut",
        "beams": [
            ["id1:", "id2:"],
            //rear springs
            {"beamPrecompression":1, "beamType":"|NORMAL"},
            {"beamSpring":33609,"beamDamp":0},
            {"beamDeform":51000,"beamStrength":251000},
            //precompressionRange specifies how much longer/shorter than spawn length the beam tries to achieve, in meters.
            //precompressionRange supersedes over beamPrecompression, make sure to only use this value inline with beams
            {"highlight":{"radius":0.01, "col":"#FFFF007F"}},
            ["rh2r","rs1r", {"name":"spring_FR","precompressionRange":0.16}],
            ["rh2l","rs1l", {"name":"spring_FL","precompressionRange":0.16}],
            {"highlight":{"radius":0.0, "col":"#00000000"}},

            //dampers
            {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
            {"beamSpring":0,"beamDamp":6362},
            {"beamLimitSpring":0,"beamLimitDamp":0},
            ["rh1r","rs1r", {"name":"damper_FR","beamDampRebound":7952,"beamDampVelocitySplit":0.1,"beamDampFast":4771,"beamDampReboundFast":3578,"dampCutoffHz":500}],
            ["rh1l","rs1l", {"name":"damper_FL","beamDampRebound":7952,"beamDampVelocitySplit":0.1,"beamDampFast":4771,"beamDampReboundFast":3578,"dampCutoffHz":500}],

            //hard bump stop
            {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.1, "beamShortBound":0.15},
            {"beamSpring":0,"beamDamp":0},
            {"beamLimitSpring":501000,"beamLimitDamp":2000},
            //the Range values determine the start of the limit in meters from spawn length (not the precompressed length)
            //basically this is where the bumpstops are first contacted
            //the boundZone value determines the transition distance where spring and damp values approach limit values after reaching the Range
            //the spring and damp move towards limit values after passing the Range distance. At Range + boundZone, the spring and damp arrive at limit values.
            //basically this is how long/progressive the bumpstop is
            //these special values supersede over shortBound and longBound, make sure to only use this value inline with beams
            ["rh1l","rs1l", {"longBoundRange":0.09,"shortBoundRange":0.09,"boundZone":0.05,"dampCutoffHz":500}],
            ["rh1r","rs1r", {"longBoundRange":0.09,"shortBoundRange":0.09,"boundZone":0.05,"dampCutoffHz":500}],
            {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        ],
    },
    }