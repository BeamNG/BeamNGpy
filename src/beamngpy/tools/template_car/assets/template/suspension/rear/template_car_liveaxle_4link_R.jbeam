            {"beamPrecompression":0.35, "beamLongBound":6},
            ["rs1l","ax1l"],
            ["rs1r","ax1r"],
            ["rs1l","ax4ll"],
            ["rs1r","ax4rr"],
            {"beamPrecompression":1},
            {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        ],

        "pressureWheels": [
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            //cancel out brake properties before future wheel parts are loaded
            {"brakeTorque":0},
            {"parkingTorque":0},
            {"enableBrakeThermals":false},
            {"brakeDiameter":false},
            {"brakeMass":false},
            {"brakeType":false},
            {"rotorMaterial":false},
            {"brakeVentingCoef":false},
        ],
    },

    "template_car_wheeldata_R_liveaxle_4link": {
        "information":{
            "authors":"BeamNG",
            "name":"Rear Spindles",
            "value":0,
        },
        "slotType" : "template_car_wheeldata_R_liveaxle_4link",
        "pressureWheels":[
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            //some wheel properties
            {"selfCollision":false},
            {"collision":true},
            {"hubcapBreakGroup":"hubcap_RR"},
            {"hubcapGroup":"hubcap_RR"},
            {"axleBeams":["axle_RR"]},
            //wheel is created from here, but using properties from previously loaded common jbeam parts
            //choosing torque reaction nodes is a very complex topic which depends mainly on whether the differential is mounted to the same "rigid" body as the wheels or not (live axle vs independent suspension) and other things
            ["RR", "wheel_RR", "tire_RR", "rw1rr", "rw1r",  9999, "ax2rr", 1, {"torqueCoupling:":"ax1rr","torqueArm:":"ax3rr","torqueArm2:":"rw1rr"}],
            {"hubcapBreakGroup":"hubcap_RL"},
            {"hubcapGroup":"hubcap_RL"},
            {"axleBeams":["axle_RL"]},
            ["RL", "wheel_RL", "tire_RL", "rw1ll", "rw1l", 9999, "ax2ll",  -1, {"torqueCoupling:":"ax1ll","torqueArm:":"ax3ll","torqueArm2:":"rw1ll"}],
            //cancel out a bunch of properties before future wheel parts are loaded
            {"selfCollision":true},
            {"axleBeams":[]},{"disableMeshBreaking":false,"disableTriangleBreaking":false},
            {"hubcapBreakGroup":""},
            {"hubcapGroup":""},
            {"enableHubcaps":false},
            {"enableTireLbeams":false},
            {"enableTireSideReinfBeams":false},
            {"enableTireReinfBeams":false},
            {"enableTreadReinfBeams":false},
            {"enableTirePeripheryReinfBeams":false},
            {"loadSensitivitySlope":""},
            {"noLoadCoef":""},
            {"fullLoadCoef":""},
            {"frictionCoef":""},
            {"slidingFrictionCoef":""},
            {"softnessCoef":0.5},
            {"treadCoef":1.0},
        ],
    },
    "template_car_swaybar_R_liveaxle_4link": {
        "information":{
            "authors":"BeamNG",
            "name":"Rear Sway Bar",
            "value":250,
        },
        "slotType" : "template_car_swaybar_R_liveaxle_4link",
        "flexbodies": [
            ["mesh", "[group]:", "nonFlexMaterials"],
            //["swaybar_R", ["lowerarms_R", "swaybar_R"]],
        ],
        "torsionbars": [
            ["id1:", "id2:", "id3:", "id4:"],
            //torsional spring rate (Nm/rad) NOT end spring rate
            {"spring":500, "damp":1, "deform":10000, "strength":50000},
            ["arbrr", "rx1r", "rx1l", "arbrl"],
        ],
        "nodes": [
            ["id", "posX", "posY", "posZ"],
            {"selfCollision":false},
            {"collision":true},
            {"nodeMaterial":"|NM_METAL"},
            {"frictionCoef":0.5},
            {"group":"swaybar_R"},
            {"nodeWeight":1.5},
            ["arbrr", -0.61, 0, -0.1],
            ["arbrl",  0.61, 0, -0.1],
            {"group":""},
        ],
        "beams": [
            ["id1:", "id2:"],
            {"beamPrecompression":1, "beamType":"|NORMAL"},
            {"beamSpring":1501000,"beamDamp":100},
            {"beamDeform":52000,"beamStrength":712000},
            //end links
            ["arbrr","ax2rr"],
            ["arbrl","ax2ll"],
            //arm
            ["rx1r","arbrr"],
            ["rx1l","arbrl"],
            ["rx1l","arbrr"],
            ["rx1r","arbrl"],
            {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        ],
    },
    "template_car_coilover_R_liveaxle_4link": {
        "information":{
            "authors":"BeamNG",
            "name":"Rear Coilovers",
            "value":200,
        },
        "slotType" : "template_car_coilover_R_liveaxle_4link",
        "beams": [
            ["id1:", "id2:"],
            //springs
            {"beamSpring":33609,"beamDamp":0},
            {"beamDeform":51000,"beamStrength":251000},
            //precompressionRange specifies how much longer/shorter than spawn length the beam tries to achieve, in meters.
            //precompressionRange supersedes over beamPrecompression, make sure to only use this value inline with beams
            {"highlight":{"radius":0.01, "col":"#FFFF007F"}},
            ["ax4rr","rs1r", {"name":"spring_RR","precompressionRange":0.100}],
            ["ax4ll","rs1l", {"name":"spring_RL","precompressionRange":0.100}],
            {"highlight":{"radius":0.0, "col":"#00000000"}},

            //dampers
            {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
            {"beamSpring":0,"beamDamp":6362},
            {"beamLimitSpring":0,"beamLimitDamp":0},
            ["ax4rr","rs1r", {"name":"damper_RR","beamDampRebound":7952,"beamDampVelocitySplit":0.1,"beamDampFast":4771,"beamDampReboundFast":3578,"dampCutoffHz":500}],
            ["ax4ll","rs1l", {"name":"damper_RL","beamDampRebound":7952,"beamDampVelocitySplit":0.1,"beamDampFast":4771,"beamDampReboundFast":3578,"dampCutoffHz":500}],

            //hard bump stop
            {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.1, "beamShortBound":0.15},
            {"beamSpring":0,"beamDamp":0},
            {"beamLimitSpring":501000,"beamLimitDamp":2000},
            //the Range values determine the start of the limit in meters from spawn length (not the precompressed length)
            //basically this is where the bumpstops are first contacted
            //the boundZone value determines the transition distance where spring and damp values approach limit values after reaching the Range
            //the spring and damp move towards limit values after passing the Range distance. At Range + boundZone, the spring and damp arrive at limit values.
            //basically this is how long/progressive the bumpstop is
            //these special values supersede over shortBound and longBound, make sure to only use this value inline with beams
            ["ax4rr","rs1r", {"longBoundRange":0.09,"shortBoundRange":0.09,"boundZone":0.05,"dampCutoffHz":500}],
            ["ax4ll","rs1l", {"longBoundRange":0.09,"shortBoundRange":0.09,"boundZone":0.05,"dampCutoffHz":500}],
            {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        ],
    },
    }